@app.get("/", response_class=HTMLResponse, include_in_schema=False)
@app.get("/posts", response_class=HTMLResponse, include_in_schema=False)
def home():
    html = "<h1>My Blog</h1>"

    for post in posts:
        html += f"<h2>{post['title']}</h2>"
        html += f"<p>By {post['author']}</p>"
        html += f"<p>{post['content']}</p>"

    return html

@app.get("/api/posts")
def get_posts():
    return posts